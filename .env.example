# Copy to .env (gitignored) and fill in. Never put seeds or keys here.
OBORO_ZINGO_CLI=/path/to/zingo-cli            # zingolib built with the `nym` feature (nym-proxy beside it)
OBORO_BUYER_WALLET_DIR=/path/to/kumo-wallet   # zingo-cli --data-dir of the buyer agent's testnet wallet
OBORO_SELLER_WALLET_DIR=/path/to/tsuki-wallet # used once by setup:seller to export the UFVK, then not needed
OBORO_SELLER_VIEW_DIR=.oboro/seller-view      # view-only wallet the paywall verifies with
OBORO_SELLER_ADDRESS=                         # optional: Tsuki's utest1 address (read from the wallet if empty)
OBORO_SELLER_NYM_ADDRESS=                     # optional: read from the gate's /status if empty
OBORO_NODE_BIN=crates/target/release/oboro-node
OBORO_TUNNEL_URL=http://127.0.0.1:7410
OBORO_MAX_PER_REQUEST_ZATS=50000
OBORO_DAILY_CAP_ZATS=300000
OBORO_SPEND_FILE=.oboro/agent-spend.json
OBORO_SELLER_VIEW_BIRTHDAY=                   # optional: a recent height; the view wallet ignores older payments
